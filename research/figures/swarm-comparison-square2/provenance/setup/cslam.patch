@@ -1,6 +1,37 @@
 cmake_minimum_required(VERSION 3.5)
 project(cslam)
 
+# Build the upstream Python LiDAR frontend and C++ decentralized backend
+# without pulling in the unrelated RTAB-Map visual frontend implementation.
+option(CSLAM_LIDAR_ONLY "Build LiDAR frontend and decentralized PGO only" OFF)
+if(CSLAM_LIDAR_ONLY)
+  set(CMAKE_CXX_STANDARD 17)
+  find_package(ament_cmake REQUIRED)
+  find_package(ament_cmake_python REQUIRED)
+  find_package(GTSAM CONFIG REQUIRED)
+  set(lidar_dependencies rclcpp sensor_msgs nav_msgs geometry_msgs std_msgs
+      diagnostic_msgs tf2_ros cslam_common_interfaces)
+  foreach(dependency IN LISTS lidar_dependencies)
+    find_package(${dependency} REQUIRED)
+  endforeach()
+  if("$ENV{ROS_DISTRO}" STRLESS "iron")
+    add_definitions(-DPRE_ROS_IRON)
+  endif()
+  add_executable(pose_graph_manager
+    src/back_end/decentralized_pgo.cpp src/back_end/pose_graph_manager_node.cpp
+    src/back_end/utils/logger.cpp src/back_end/gtsam_utils.cpp
+    src/back_end/utils/simulated_rendezvous.cpp)
+  target_include_directories(pose_graph_manager PRIVATE include)
+  ament_target_dependencies(pose_graph_manager ${lidar_dependencies})
+  target_link_libraries(pose_graph_manager gtsam)
+  install(TARGETS pose_graph_manager DESTINATION lib/${PROJECT_NAME})
+  ament_python_install_package(${PROJECT_NAME})
+  install(PROGRAMS cslam/loop_closure_detection_node.py cslam/lidar_handler_node.py
+    DESTINATION lib/${PROJECT_NAME})
+  ament_package()
+  return()
+endif()
+
 # Default to C99
